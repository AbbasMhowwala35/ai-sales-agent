# ---- Core ----
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000      # public HTTPS URL in production (Twilio/Vapi webhooks call it)
CLIENT_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/dialstack   # leave empty to use an embedded in-memory MongoDB (dev only)
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-another-long-random-string   # AES-256-GCM key material for PII at rest

# ---- AI (optional — without a key the agent runs on built-in rule-based dialogue + local embeddings) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint

# ---- Telephony: simulator (default) | twilio | vapi ----
TELEPHONY_PROVIDER=simulator
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Telnyx (free trial credit; works for AI calls — preferred over Twilio when set)
TELNYX_API_KEY=
TELNYX_ACCOUNT_SID=
TELNYX_APP_ID=
TELNYX_FROM_NUMBER=
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=

# ---- Natural voices & voice cloning ----
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ---- Lead data providers ----
GOOGLE_PLACES_API_KEY=
APOLLO_API_KEY=
ENABLE_SANDBOX_LEADS=true

# ---- Email / calendar ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Dialstack <no-reply@yourdomain.com>"
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# ---- Ops ----
STORAGE_DIR=./storage
RUN_WORKERS=true
RATE_LIMIT_PER_MINUTE=300
